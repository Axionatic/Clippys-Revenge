#!/bin/bash
# Clippy's Revenge — uninstall shim
#
# Resolves to the installed uninstall.sh and execs it.

set -euo pipefail

resolve_path() {
    local target="$1"
    while [ -L "$target" ]; do
        local dir
        dir="$(cd "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        [[ "$target" != /* ]] && target="$dir/$target"
    done
    cd "$(dirname "$target")" && pwd
}

SCRIPT_DIR="$(resolve_path "$0")"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

exec bash "$PROJECT_ROOT/uninstall.sh" "$@"
